{
  "ConnectionStrings": {
    "Default": "Server=(localdb)\\MSSQLLocalDB;Database=Mehfil;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=True"
  },
  "Database": {
    "AutoMigrate": true,
    "SeedData": true
  },
  "Jwt": {
    "Secret": "",
    "Issuer": "mehfil-api",
    "Audience": "mehfil-app",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 30
  },
  "Google": {
    "ClientIds": []
  },
  "DevLogin": {
    "Enabled": false
  },
  "Storage": {
    "LocalRoot": "wwwroot/uploads",
    "PublicPath": "/uploads",
    "MaxUploadBytes": 5242880
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      }
    ]
  },
  "AllowedHosts": "*"
}
