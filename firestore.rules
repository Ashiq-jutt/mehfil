rules_version = '2';

// Default-deny baseline. Each feature adds its own match blocks here
// together with the feature, so nothing is ever left open during development.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
