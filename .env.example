# ─────────────────────────────────────────────────────────────
# Mehfil — React Native client configuration
# Copy to .env and fill in. Read at build time by react-native-config.
#
# EVERYTHING IN THIS FILE SHIPS INSIDE THE APP BINARY AND IS PUBLIC.
# Never put secrets here (no JWT secret, no Agora App Certificate).
# ─────────────────────────────────────────────────────────────

# ── Backend API (backend/ — ASP.NET Core) ────────────────────
# Android emulator reaches the host via 10.0.2.2; iOS simulator uses localhost.
# For a physical device use your machine's LAN IP, e.g. http://192.168.1.20:5080
# Leave empty to use the platform default (10.0.2.2 / localhost on port 5080).
API_BASE_URL=

# ── Google Sign-In ───────────────────────────────────────────
# Create OAuth clients in Google Cloud Console → APIs & Services → Credentials:
#   • Web client        → GOOGLE_WEB_CLIENT_ID (also add it to backend Google:ClientIds)
#   • Android client    → package com.jalopy.mehfil + debug SHA-1 (no value needed here)
#   • iOS client        → bundle id com.jalopy.mehfil → GOOGLE_IOS_CLIENT_ID, and put its
#                         REVERSED client id as a URL scheme in ios/Mehfil/Info.plist
GOOGLE_WEB_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=

# ── Developer login (debug builds only) ──────────────────────
# Shows a "Developer login" button that signs in by email through the backend's
# /auth/dev endpoint (backend DevLogin:Enabled must be true). Handy before OAuth is set up.
DEV_LOGIN_ENABLED=true

# ── Agora RTC ────────────────────────────────────────────────
# App ID is public. The App Certificate lives only in the backend configuration.
AGORA_APP_ID=

# Push notifications (needs google-services.json / GoogleService-Info.plist from your Firebase project).
# Leave false until those files are in place; the app then skips Firebase entirely.
PUSH_ENABLED=false
