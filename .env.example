# ─────────────────────────────────────────────────────────────
# VoxNest — React Native client configuration
# Copy to .env and fill in. Read at build time by react-native-config.
#
# EVERYTHING IN THIS FILE SHIPS INSIDE THE APP BINARY AND IS PUBLIC.
# Never put secrets here (no Agora App Certificate, no service accounts).
# ─────────────────────────────────────────────────────────────

# ── Firebase ─────────────────────────────────────────────────
# Native Firebase config does NOT come from this file. Download from
# Firebase Console → Project settings → Your apps:
#   android/app/google-services.json        (package: com.voxnest.app)
#   ios/VoxNest/GoogleService-Info.plist    (bundle id: com.voxnest.app)
# Both files are gitignored.

# Must match setGlobalOptions({ region }) in functions/src/index.ts
FIREBASE_FUNCTIONS_REGION=us-central1

# Point the app at the local Firebase Emulator Suite (debug builds only).
USE_FIREBASE_EMULATOR=false
# Android emulator reaches the host via 10.0.2.2; iOS simulator uses localhost.
# For a physical device use your machine's LAN IP.
FIREBASE_EMULATOR_HOST_ANDROID=10.0.2.2
FIREBASE_EMULATOR_HOST_IOS=localhost

# ── Firebase App Check ───────────────────────────────────────
# Debug builds use the debug provider; register the debug token printed in
# the device log under Firebase Console → App Check → Manage debug tokens.
APP_CHECK_ENABLED=false

# ── Google Sign-In ───────────────────────────────────────────
# The *Web* OAuth client ID (client_type 3 in google-services.json),
# NOT the Android/iOS client ID.
GOOGLE_WEB_CLIENT_ID=
# iOS only: CLIENT_ID from GoogleService-Info.plist. Its REVERSED_CLIENT_ID
# must also be added as a URL scheme in ios/VoxNest/Info.plist.
GOOGLE_IOS_CLIENT_ID=

# ── Agora RTC ────────────────────────────────────────────────
# App ID is public. The App Certificate is NOT set here — see below.
AGORA_APP_ID=

# ─────────────────────────────────────────────────────────────
# SERVER-SIDE ONLY (Cloud Functions) — do NOT add to .env
# ─────────────────────────────────────────────────────────────
# Stored in Google Secret Manager (requires Blaze plan):
#   firebase functions:secrets:set AGORA_APP_ID
#   firebase functions:secrets:set AGORA_APP_CERTIFICATE
# For the local emulator, put them in functions/.secret.local (gitignored):
#   AGORA_APP_ID=...
#   AGORA_APP_CERTIFICATE=...
#
# ── Firebase Storage ─────────────────────────────────────────
# Bucket comes from google-services.json / GoogleService-Info.plist.
#
# ── FCM ──────────────────────────────────────────────────────
# Android: no extra config (uses google-services.json).
# iOS: upload an APNs Authentication Key (.p8) under
#   Firebase Console → Project settings → Cloud Messaging → Apple app configuration,
# and enable Push Notifications + Background Modes (Remote notifications) in Xcode.
