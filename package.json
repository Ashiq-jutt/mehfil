{
  "name": "mehfil",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "npx react-native run-android",
    "ios": "npx react-native run-ios",
    "start": "react-native start",
    "cache-reset": "react-native start --reset-cache",
    "kill-port": "lsof -ti:8081 | xargs kill -9",
    "asset": "npx react-native-asset",
    "clean": "cd android && ./gradlew clean",
    "pods": "cd ios && pod install --repo-update",
    "report": "cd android && ./gradlew signinReport",
    "postversion": "react-native-version",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "fonts": "react-native-asset",
    "check": "npm run typecheck && npm run lint && npm test"
  },
  "dependencies": {
    "@react-native-google-signin/google-signin": "16.1.5",
    "@react-navigation/material-top-tabs": "7.6.17",
    "@react-navigation/native": "7.3.18",
    "@react-navigation/native-stack": "7.18.10",
    "@tanstack/react-query": "5.102.8",
    "axios": "1.20.0",
    "react": "19.2.3",
    "react-native": "0.87.1",
    "react-native-config": "1.7.2",
    "react-native-keychain": "10.0.0",
    "react-native-linear-gradient": "2.8.3",
    "react-native-pager-view": "9.0.4",
    "react-native-safe-area-context": "5.9.1",
    "react-native-screens": "4.28.0",
    "react-native-svg": "15.15.5",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.2.0",
    "@react-native-community/cli-platform-android": "20.2.0",
    "@react-native-community/cli-platform-ios": "20.2.0",
    "@react-native/babel-preset": "0.87.1",
    "@react-native/eslint-config": "0.87.1",
    "@react-native/jest-preset": "0.87.1",
    "@react-native/metro-config": "0.87.1",
    "@react-native/typescript-config": "0.87.1",
    "@testing-library/react-native": "14.0.1",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.2.0",
    "@types/react-test-renderer": "^19.1.0",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "prettier": "2.8.8",
    "react-native-asset": "2.3.0",
    "react-test-renderer": "19.2.3",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">= 22.11.0"
  }
