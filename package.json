{
  "name": "voxnest",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "npx react-native run-android",
    "ios": "npx react-native run-ios",
    "start": "react-native start",
    "cache-reset": "react-native start --reset-cache",
    "kill-port": "lsof -ti:8081 | xargs kill -9",
    "asset": "npx react-native-asset",
    "clean": "cd android && ./gradlew clean",
    "pods": "cd ios && pod install --repo-update",
    "report": "cd android && ./gradlew signinReport",
    "postversion": "react-native-version",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "emulators": "firebase emulators:start --import=./emulator-data --export-on-exit",
    "functions:build": "npm --prefix functions run build",
    "test": "jest"
  },
  "dependencies": {
    "@react-native-firebase/app": "26.4.0",
    "@react-native-firebase/app-check": "26.4.0",
    "@react-native-firebase/auth": "26.4.0",
    "@react-native-firebase/firestore": "26.4.0",
    "@react-native-firebase/functions": "26.4.0",
    "@react-native-firebase/messaging": "26.4.0",
    "@react-native-firebase/storage": "26.4.0",
    "@react-native/new-app-screen": "0.87.1",
    "react": "19.2.3",
    "react-native": "0.87.1",
    "react-native-config": "1.7.2",
    "react-native-safe-area-context": "5.9.1"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.2.0",
    "@react-native-community/cli-platform-android": "20.2.0",
    "@react-native-community/cli-platform-ios": "20.2.0",
    "@react-native/babel-preset": "0.87.1",
    "@react-native/eslint-config": "0.87.1",
    "@react-native/jest-preset": "0.87.1",
    "@react-native/metro-config": "0.87.1",
    "@react-native/typescript-config": "0.87.1",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.2.0",
    "@types/react-test-renderer": "^19.1.0",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "prettier": "2.8.8",
    "react-test-renderer": "19.2.3",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">= 22.11.0"
  }
}
